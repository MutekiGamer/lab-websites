---
import "@fontsource-variable/manrope";
import "../../styles/global.css";
import "../../styles/construction-agent.css";
import ResearchNav from "../../components/ResearchNav.astro";
import ResourceLink from "../../components/ResourceLink.astro";
import ImageViewer from "../../components/ImageViewer.astro";
import { constructionAgent as product } from "../../data/construction-agent";
import { localPath } from "../../lib/paths";
const video = localPath("construction-agent/walkscribe-v3-full-cut-r8.mp4");
const media = (name: string) => localPath(`construction-agent/story/${name}`);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={product.description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={product.title} />
    <meta property="og:description" content={product.description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={localPath("research.svg")} type="image/svg+xml" />
    <title>{product.title}</title>
  </head>
  <body class="walkscribe-story">
    <a class="skip-link" href="#overview">Skip to product overview</a>
    <ResearchNav current="construction-agent" />
    <main class="page-container">
      <header id="overview" class="walk-hero">
        <div class="walk-hero-copy">
          <p class="walk-eyebrow">Walkscribe / AI for construction fieldwork</p>
          <h1>A blocked exit.<br />What happens<br />next?</h1>
          <p class="walk-hero-intro">During an inspection walkthrough, you record the blocked exit in Take Notes, with a photo as evidence. Someone still needs to confirm the issue, arrange a response, and verify the work. <strong>Walkscribe keeps those steps connected.</strong></p>
          <div class="walk-resources" aria-label="Product links">
            <ResourceLink href={product.website} icon="website">Product Website</ResourceLink>
            <ResourceLink href="#team" icon="team">Teams</ResourceLink>
          </div>
          <p class="walk-byline">An AI field assistant, built at the University of Florida.</p>
        </div>
        <figure class="entry-evidence">
          <div class="evidence-topline"><span>Recorded during the inspection</span><span class="issue-dot">Open</span></div>
          <img src={media("entry-evidence.jpg")} alt="Photo evidence of boxes blocking an exit, attached to an inspection note in the Walkscribe demonstration." width="648" height="378" fetchpriority="high" />
          <figcaption>
            <span class="entry-title">Blocked exit</span>
            <span class="entry-subtitle">Recorded in Take Notes.<br />Photo evidence retained.</span>
          </figcaption>
          <div class="evidence-trail" aria-label="What the finding needs"><span>Evidence</span><span aria-hidden="true">→</span><span>An owner</span><span aria-hidden="true">→</span><span>Verification</span></div>
        </figure>
      </header>

      <nav class="section-nav walk-nav" aria-label="Page sections">
        <a href="#follow-through">Follow the finding</a><a href="#field-guidance">Guide the work</a><a href="#in-the-field">Use it on site</a><a href="#demo">Full demo</a>
      </nav>

      <section id="follow-through" class="walk-section">
        <div class="walk-section-heading">
          <div><p class="walk-eyebrow">01 / One finding, through every handoff</p><h2>Keep the issue moving.<br />Keep its context with it.</h2></div>
          <p>Follow the blocked-exit finding from an inspection note through the product demo. Kira helps organize the information; the people doing the work make the decisions.</p>
        </div>
        <div class="case-story" data-walk-tabs>
          <div class="case-tabs" role="tablist" aria-label="Follow the blocked-exit finding">
            {product.cases.map((item, i) => <button type="button" id={`tab-${item.id}`} role="tab" aria-controls={`case-${item.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}><span>{item.number}</span>{item.label}</button>)}
          </div>
          {product.cases.map((item, i) => (
            <div class="case-panel" id={`case-${item.id}`} role="tabpanel" aria-labelledby={`tab-${item.id}`} tabindex="0" hidden={i !== 0}>
              <figure class="walk-clip">
                <video data-walk-clip loop muted playsinline controls preload="metadata" poster={media(`${item.id}.jpg`)} width="1280" height="720" aria-label={`${item.label}: product demonstration excerpt`}>
                  <source src={media(`${item.id}.mp4`)} type="video/mp4" /><a href={media(`${item.id}.mp4`)}>Watch {item.label.toLowerCase()}</a>
                </video>
                <figcaption>Product demo excerpt · Silent loop · Full narrated video below</figcaption>
              </figure>
              <div class="case-copy">
                <h3>{item.title}</h3><p>{item.description}</p>
                <dl class="issue-record" aria-label="Finding status shown in this demonstration step">{item.records.map((record) => <div><dt>{record.label}</dt><dd>{record.value}</dd></div>)}</dl>
                <p class="human-check"><span aria-hidden="true">↳</span>{item.takeaway}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="review-principle"><p class="walk-eyebrow">The handoff that matters</p><p>A finding can have an owner and still be open.<br /><strong>Human verification is what closes the loop.</strong></p></div>
      </section>

      <section id="field-guidance" class="walk-section">
        <div class="walk-section-heading">
          <div><p class="walk-eyebrow">02 / From follow-up to fieldwork</p><h2>Bring the answer<br />to the work.</h2></div>
          <p>The follow-up task carries its drawings and instructions forward. The crew can see the reference, understand the next action, and keep the guidance with the task.</p>
        </div>
        <div class="guidance-story" data-walk-tabs>
          <div class="guidance-tabs" role="tablist" aria-label="Ways to present field guidance">
            {product.guidance.map((item, i) => <button type="button" id={`tab-${item.id}`} role="tab" aria-controls={`guidance-${item.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>{item.label}</button>)}
          </div>
          {product.guidance.map((item, i) => (
            <div id={`guidance-${item.id}`} role="tabpanel" aria-labelledby={`tab-${item.id}`} tabindex="0" hidden={i !== 0}>
              <figure class="guidance-clip">
                <video data-walk-clip loop muted playsinline controls preload="metadata" poster={media(`${item.id}.jpg`)} width="1280" height="720" aria-label={`${item.label}: field guidance shown in the product demo`}>
                  <source src={media(`${item.id}.mp4`)} type="video/mp4" /><a href={media(`${item.id}.mp4`)}>Watch field guidance {item.label.toLowerCase()}</a>
                </video>
                <figcaption><strong>{item.title}</strong><span>{item.description}</span></figcaption>
              </figure>
            </div>
          ))}
        </div>
      </section>

      <section id="in-the-field" class="walk-section">
        <div class="walk-section-heading">
          <div><p class="walk-eyebrow">03 / Fit the way fieldwork happens</p><h2>Start with a phone.<br />Make room for hands-free work.</h2></div>
          <p>The mobile browser is the starting point. Connected cameras and audio extend the same conversation to a wearable setup, as presented in the product materials.</p>
        </div>
        <div class="product-surfaces">
          <article>
            <a class="surface-image figure-link" data-zoom href={media("mobile-app.jpg")} aria-label="Enlarge the Walkscribe mobile interface"><img src={media("mobile-app.jpg")} alt="Walkscribe mobile interface with a live camera view and a priority confirmation prompt." width="1600" height="1000" loading="lazy" /><span class="enlarge-hint">↗ Enlarge</span></a>
            <div class="surface-copy"><span class="surface-label">Mobile browser</span><h3>See it. Say it. Confirm it.</h3><p>Use the phone’s camera and voice interface to keep the observation, conversation, and evidence together.</p></div>
          </article>
          <article>
            <div class="surface-image"><img src={media("connected-helmet.jpg")} alt="Connected helmet with camera and headset, presented in the Walkscribe product demonstration." width="1280" height="720" loading="lazy" /></div>
            <div class="surface-copy"><span class="surface-label">Connected helmet</span><h3>Keep the conversation with the worker.</h3><p>The demonstrated wearable setup brings camera capture and audio to a hard hat for hands-free interaction.</p></div>
          </article>
        </div>
      </section>

      <section id="demo" class="walk-section demo-section" aria-label="Walkscribe full product demonstration">
        <div class="walk-section-heading">
          <div><p class="walk-eyebrow">The complete walkthrough</p><h2>Watch the finding<br />travel through the work.</h2></div>
          <p>Start with the drawings. Follow the inspection, coordination, and guidance. See how responsibility stays visible until human review.</p>
        </div>
        <figure class="demo-video">
          <video id="product-video" controls playsinline preload="metadata" poster={localPath("construction-agent/walkscribe-poster.jpg")} width="1920" height="1080" aria-label="Walkscribe complete narrated product demonstration" aria-describedby="video-description">
            <source src={video} type="video/mp4" /><p>Your browser does not support this video. <a href={video}>Open the demonstration video.</a></p>
          </video>
          <figcaption id="video-description">4 min 34 sec · Narration with on-screen subtitles</figcaption>
        </figure>
        <div class="video-scenes" aria-label="Jump to a demonstration scene" hidden>
          {product.scenes.map((scene) => <button type="button" data-seek={scene.seconds} data-scene-label={`${scene.title} · ${scene.time}`} aria-controls="product-video"><span>{scene.time}</span>{scene.title}</button>)}
        </div>
        <p id="video-status" class="video-status" role="status" aria-live="polite"></p>
      </section>

      <section class="walk-closing" aria-label="Explore the product"><p class="walk-eyebrow">Walkscribe</p><h2>A finding. An owner.<br />A clear next step.</h2><p>Keep the evidence and the people connected<br />from the first observation to the next check.</p><ResourceLink href={product.website} icon="website">Explore the Product</ResourceLink></section>

      <section id="team" class="product-team-section">
        <div class="team-heading"><h2>Product team</h2><p>University of Florida</p></div>
        <ul class="product-team">{product.team.map((member) => <li><span>{member.name}</span><span>{member.role}</span></li>)}</ul>
      </section>
    </main>
    <footer>
      <p>Product content and media from <a href={product.website}>Walkscribe</a> and the supplied demonstration.</p>
      <p>Design adapted from <a href="https://github.com/RomanHauksson/academic-project-astro-template">Roman Hauksson-Neill’s academic project template</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. Product materials retain their respective rights.</p>
    </footer>
    <ImageViewer />
    <script>
      const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
      const clips = Array.from(document.querySelectorAll<HTMLVideoElement>("[data-walk-clip]"));
      // Automatic playback stops outside the viewport; user-operated controls take precedence.
      const visible = new WeakSet<HTMLVideoElement>();
      const manual = new WeakSet<HTMLVideoElement>();
      const canAutoPlay = (clip: HTMLVideoElement) => !motionPreference.matches && !manual.has(clip) && !clip.closest("[hidden]");
      clips.forEach((clip) => {
        clip.addEventListener("pointerdown", () => manual.add(clip));
        clip.addEventListener("keydown", () => manual.add(clip));
      });
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const clip = entry.target as HTMLVideoElement;
          if (entry.isIntersecting && entry.intersectionRatio >= .3) {
            visible.add(clip);
            if (canAutoPlay(clip)) clip.play().catch(() => {});
          } else {
            visible.delete(clip);
            clip.pause();
          }
        });
      }, { threshold: [0, .3] });
      clips.forEach((clip) => observer.observe(clip));
      motionPreference.addEventListener("change", () => {
        clips.forEach((clip) => {
          if (motionPreference.matches) clip.pause();
          else if (visible.has(clip) && canAutoPlay(clip)) clip.play().catch(() => {});
        });
      });
      document.querySelectorAll<HTMLElement>("[data-walk-tabs]").forEach((group) => {
        const tabs = Array.from(group.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
        const select = (chosen: HTMLButtonElement) => {
          tabs.forEach((tab) => {
            const active = tab === chosen;
            tab.setAttribute("aria-selected", String(active));
            tab.tabIndex = active ? 0 : -1;
            const panel = document.getElementById(tab.getAttribute("aria-controls") ?? "");
            if (!panel) return;
            panel.hidden = !active;
            panel.querySelectorAll<HTMLVideoElement>("video").forEach((clip) => { if (!active) clip.pause(); });
          });
        };
        tabs.forEach((tab, index) => {
          tab.addEventListener("click", () => select(tab));
          tab.addEventListener("keydown", (event) => {
            let next = index;
            if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
            else if (event.key === "ArrowLeft") next = (index + tabs.length - 1) % tabs.length;
            else if (event.key === "Home") next = 0;
            else if (event.key === "End") next = tabs.length - 1;
            else return;
            event.preventDefault(); select(tabs[next]); tabs[next].focus();
          });
        });
      });
      const video = document.querySelector<HTMLVideoElement>("#product-video")!;
      const sceneList = document.querySelector<HTMLElement>(".video-scenes")!;
      const status = document.querySelector<HTMLElement>("#video-status")!;
      const buttons = Array.from(sceneList.querySelectorAll<HTMLButtonElement>("[data-seek]"));
      sceneList.hidden = false;
      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const seconds = Number(button.dataset.seek);
          const seek = () => {
            video.pause();
            video.currentTime = seconds;
            status.textContent = `Selected scene: ${button.dataset.sceneLabel}. Use the video controls to play.`;
          };
          if (video.readyState >= 1) seek();
          else { video.addEventListener("loadedmetadata", seek, { once: true }); video.load(); }
        });
      });
      video.addEventListener("play", () => clips.forEach((clip) => clip.pause()));
      video.addEventListener("timeupdate", () => {
        const current = buttons.findLast((button) => Number(button.dataset.seek) <= video.currentTime);
        buttons.forEach((button) => {
          if (button === current) button.setAttribute("aria-current", "true");
          else button.removeAttribute("aria-current");
        });
      });
      video.addEventListener("error", () => { status.textContent = "The video could not load. Please reload this page or open the product website."; });
    </script>
  </body>
</html>
