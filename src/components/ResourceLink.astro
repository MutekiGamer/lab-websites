---
interface Props { href: string; icon: "paper" | "pdf" | "slides" | "citation" | "website" | "team"; }
const { href, icon } = Astro.props;
const paths = {
  team: "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75",
  website: "M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM3 12h18M12 3c-5 5-5 13 0 18M12 3c5 5 5 13 0 18",
  paper: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8m-6-6v6h6M8 13h8M8 17h6",
  pdf: "M12 3v12m-5-5 5 5 5-5M5 16v5h14v-5",
  slides: "M3 3h18v13H3zM12 16v5m-5 0 5-5 5 5M7 8h10M7 11h6",
  citation: "M9 5H3v8h6V5Zm0 8c0 4-2 6-6 6M21 5h-6v8h6V5Zm0 8c0 4-2 6-6 6",
};
---
<a class="resource-link" href={href}>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[icon]} /></svg>
  <slot />
</a>
