---
import { research } from "../data/research";
import { localPath } from "../lib/paths";
interface Props { current: string; }
const { current } = Astro.props;
---
<nav class="research-nav" aria-label="Research and products">
  <a class="research-home" href={localPath()} aria-label="Research and products home" aria-current={current === "all" ? "page" : undefined}>
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 10 9-7 9 7M5 9v12h5v-7h4v7h5V9" /></svg>
  </a>
  <details class="research-dropdown">
    <summary>More Research <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m3 6 5 5 5-5" /></svg></summary>
    <ul class="research-list">
      {research.map((item) => (
        <li><a href={localPath(item.path)} aria-current={item.id === current ? "page" : undefined}>{item.name}{item.id === current && <span aria-hidden="true">✓</span>}</a></li>
      ))}
    </ul>
  </details>
</nav>
<script>
  document.querySelectorAll<HTMLDetailsElement>(".research-dropdown").forEach((menu) => {
    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
  });
</script>
<style>
  .research-nav { position: relative; z-index: 20; display: flex; align-items: stretch; justify-content: center; min-height: 52px; font-size: 15px; }
  .research-home { display: flex; align-items: center; padding: 0 16px; color: #626269; }
  .research-home:hover { background: #f7f7f8; color: var(--link); }
  .research-dropdown { position: relative; }
  summary { display: flex; align-items: center; gap: 12px; height: 52px; padding: 0 15px; list-style: none; color: #55555e; }
  summary::-webkit-details-marker { display: none; }
  summary:hover, details[open] summary { background: #f7f7f8; color: var(--link); }
  details[open] summary svg { transform: rotate(180deg); }
  .research-list { position: absolute; top: 100%; left: 0; width: 235px; max-width: calc(100vw - 40px); background: #fff; list-style: none; padding: 8px 0; margin: 0; border: 1px solid #e9e9ec; border-radius: 0 0 5px 5px; box-shadow: 0 7px 18px #00000010; }
  .research-list a { display: flex; gap: 16px; align-items: center; justify-content: space-between; padding: 10px 17px; color: #505057; font-size: 14px; text-decoration: none; line-height: 1.5; }
  .research-list a:hover { background: #f5f6f8; color: var(--link); }
  .research-list a[aria-current="page"] { color: var(--link); background: #f4f7fb; }
  .research-list span { font-size: 12px; }
  @media (max-width: 500px) { .research-list { left: auto; right: 0; width: 215px; } }
  @media print { .research-nav { display: none; } }
</style>
