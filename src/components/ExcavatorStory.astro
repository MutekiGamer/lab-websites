---
import MotionFigure from "./MotionFigure.astro";
import Figure from "./Figure.astro";
import { localPath } from "../lib/paths";

const dataChallenges = [
  { file: "redundant-motion", label: "Redundant", title: "Repeated motions add little useful guidance.", text: "The recording grows without showing a new way to complete the task." },
  { file: "irrelevant-motion", label: "Irrelevant", title: "Not every recorded motion contributes to the dig.", text: "Unrelated movements obscure the actions the robot needs to learn." },
  { file: "failed-motion", label: "Failed", title: "An attempted motion can fail to complete the task.", text: "Successful demonstrations are still needed; selecting keyframes does not turn a failed attempt into one." },
];
const experiments = [
  {
    id: "contour", title: "Excavation with a specified terrain goal.", file: "contour-map-goal",
    image: "specified-goal-results.png", width: 2834, height: 2158,
    alt: "Simulation success-rate comparison with a specified terrain goal; the proposed method outperforms the compared methods",
    finding: "In simulation, the full policy improves task success over the compared methods, including the version without the policy that learns motions between subgoals.",
  },
  {
    id: "vision", title: "Excavation with a goal learned from vision.", file: "visual-latent-goal",
    image: "visual-goal-results.png", width: 840, height: 642,
    alt: "Simulation success-rate comparison with a learned visual goal; the proposed method outperforms the compared methods",
    finding: "The visual policy improves task success over the compared methods without requiring a manually specified final goal. Linking visual features to robot actions improves learning.",
  },
];
---

<section id="research" class="research-section frame">
  <h2>The robot digs under human control.</h2>
  <div id="demonstrations" class="operator-demonstrations">
    <MotionFigure file="operator-control" title="Teleoperation.">An operator guides the laboratory robot through a digging task.</MotionFigure>
    <MotionFigure file="teleoperation-testbed" title="Demonstration collection.">Robot states and visual observations are recorded together for learning.</MotionFigure>
  </div>
</section>

<section id="challenges" class="challenges-section frame">
  <h2>Challenges to autonomous excavation</h2>
  <div class="challenge-columns">
    <article id="data-challenge" class="challenge-column">
      <h3>Data challenge</h3>
      <div data-tabs>
        <div class="challenge-tabs" role="tablist" aria-label="Demonstration quality examples">
          {dataChallenges.map((item, i) => <button type="button" id={`${item.file}-tab`} role="tab" aria-controls={`example-${item.file}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>{item.label}</button>)}
        </div>
        {dataChallenges.map((item, i) => <div id={`example-${item.file}`} role="tabpanel" aria-labelledby={`${item.file}-tab`} tabindex="0" hidden={i !== 0}>
          <MotionFigure file={item.file} title={item.title}>{item.text}</MotionFigure>
        </div>)}
      </div>
    </article>
    <div class="challenge-connection"><span aria-hidden="true">→</span><p>Poor demonstrations make reliable learning harder.</p></div>
    <article id="learning-challenge" class="challenge-column">
      <h3>Learning challenge</h3>
      <div class="learning-context" aria-hidden="true"></div>
      <MotionFigure file="learning-challenge" title="The robot moves, but does not reliably complete a dig.">Limited demonstrations and complex visual observations make it difficult to learn which actions will achieve the excavation goal.</MotionFigure>
    </article>
  </div>
</section>

<section id="method" class="method-section frame">
  <h2>Our solution learns from keyframes and visual goals.</h2>
  <div class="framework-evidence">
    <Figure file="method-framework.png" alt="Keyframe selection and action-bound visual representations guide a high-level subgoal policy and a low-level action policy" width={1430} height={629}>
      <span class="framework-caption">Demonstrations and scene observations provide the training inputs; the learned policies generate robot actions.</span>
    </Figure>
  </div>
  <div class="framework-modules">
    <article><h3>Select useful demonstration frames.</h3><p>Keyframe selection reduces redundant data while retaining the poses that guide the task.</p></article>
    <article><h3>Represent the scene and its goal.</h3><p>A compact visual representation preserves information relevant to robot actions and supports goal generation.</p></article>
    <article><h3>Learn the actions between subgoals.</h3><p>A high-level policy proposes subgoals; a low-level policy learns how to reach them.</p></article>
  </div>
  <div class="visual-method-figures">
    <figure class="challenge-figure"><div class="challenge-still"><img src={localPath("images/research/calibrated-site.png")} width="794" height="846" loading="lazy" alt="Calibrated point cloud aligned with the laboratory robot’s working space" /></div><figcaption><strong>Align observations with the robot.</strong>Calibration places the scene in the robot’s working coordinate frame before visual encoding.</figcaption></figure>
    <figure class="challenge-figure"><div class="terrain-pair"><div><img src={localPath("images/research/site-contour.png")} width="1651" height="1697" loading="lazy" alt="Current terrain contour in the research testbed" /><span>Current site</span></div><span class="terrain-arrow" aria-hidden="true">→</span><div><img src={localPath("images/research/target-contour.png")} width="1263" height="1022" loading="lazy" alt="Desired terrain contour with an excavation depression" /><span>Target contour</span></div></div><figcaption><strong>Learn the intended change.</strong>Initial and final demonstration observations train goal generation. These contours illustrate the state–goal relationship.</figcaption></figure>
  </div>
</section>

<section id="results" class="results-section frame">
  <h2>The learned policy improves excavation success.</h2>
  <div class="keyframe-proof" id="result-keyframes">
    <Figure file="keyframe-extraction.png" alt="Selected keyframes marked as red points along a recorded robot trajectory" width={1397} height={611}><strong>Keyframes preserve the essential motion.</strong>The selected poses provide a more compact demonstration for training, with fewer redundant frames.</Figure>
  </div>
  <div class="experiment-comparisons" id="result-task-performance">
    {experiments.map(experiment => <article class="experiment-case" id={`experiment-${experiment.id}`}>
      <MotionFigure file={experiment.file} title={experiment.title}>{experiment.finding}</MotionFigure>
      <details class="technical-detail simulation-evidence">
        <summary>Simulation comparison <span aria-hidden="true">+</span></summary>
        <figure class="experiment-plot"><a class="figure-link" data-zoom href={localPath(`images/research/${experiment.image}`)} aria-label={`Enlarge simulation comparison for ${experiment.id === "contour" ? "specified terrain goals" : "visual goals"}`}><img src={localPath(`images/research/${experiment.image}`)} width={experiment.width} height={experiment.height} loading="lazy" alt={experiment.alt} /><span class="enlarge-hint">↗ Enlarge</span></a><figcaption>Brown curve: proposed method. These curves report simulation trials, separate from the laboratory clip above.</figcaption></figure>
      </details>
    </article>)}
  </div>
  <p class="validation-boundary">The videos show laboratory demonstrations; performance comparisons come from simulation. These results do not establish full-scale field performance.</p>
</section>

<section id="applications" class="applications-section frame">
  <h2>Extending our research toward lunar excavation.</h2>
  <div id="application-space" class="space-application">
    <figure class="space-image">
      <img src={localPath("images/earth-beyond/coldarm.webp")} width="1000" height="1500" loading="lazy" alt="NASA’s single articulated COLDArm with a titanium scoop above a lunar-regolith simulant test bed at JPL" />
      <figcaption>NASA’s COLDArm in a terrestrial lunar-regolith test bed. Image: <a href="https://www.jpl.nasa.gov/images/pia25317-nasas-coldarm-at-lunar-regolith-simulant-test-bed/">NASA/JPL-Caltech</a>.</figcaption>
    </figure>
    <div class="space-copy">
      <p>We aim to extend demonstration-based excavation learning to robotic arms working with lunar regolith, where communication delays make continuous remote control difficult.</p>
      <p>This direction requires new demonstrations and validation under different soil behavior, gravity, lighting, and hardware constraints.</p>
      <p>The COLDArm testbed illustrates a related single-arm excavation platform. It is external research, not a deployment of our method.</p>
    </div>
  </div>
</section>
